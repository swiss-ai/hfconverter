+    def build_conversion_tasks(self, hf_pretrained, megatron_model, weight_dtype=None):
+        buffer_names = ("beta", "eps")
+        # HF persists these fixed activation constants; MCore stores attributes.
+        for chunk in megatron_model:
+            for module in chunk.modules():
+                if not isinstance(module, XIELU):
+                    continue
+                for name in buffer_names:
+                    if name in module._buffers:
+                        continue
+                    value = torch.as_tensor(
+                        getattr(module, name),
+                        dtype=module.alpha_p.dtype,
+                        device=module.alpha_p.device,
+                    ).reshape(())
+                    delattr(module, name)
+                    module.register_buffer(name, value)
+        return super().build_conversion_tasks(hf_pretrained, megatron_model, weight_dtype=weight_dtype)
