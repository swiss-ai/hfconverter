+# Copyright (c) 2026, NVIDIA CORPORATION. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+"""Distributed conversion helpers for the AutoBridge API."""
+
+import datetime
+import os
+import shutil
+from pathlib import Path
+
+import torch
+
+from megatron.bridge import AutoBridge
+from megatron.bridge.utils.slurm_utils import resolve_slurm_master_addr, resolve_slurm_master_port
+
+
+def _ensure_distributed_initialized(timeout_minutes, *, use_cpu=False):
+    if torch.distributed.is_initialized():
+        return
+    if "WORLD_SIZE" not in os.environ and "SLURM_NTASKS" in os.environ:
+        os.environ["RANK"] = os.environ["SLURM_PROCID"]
+        os.environ["WORLD_SIZE"] = os.environ["SLURM_NTASKS"]
+        os.environ["LOCAL_RANK"] = os.environ["SLURM_LOCALID"]
+        os.environ.setdefault("MASTER_ADDR", resolve_slurm_master_addr() or "127.0.0.1")
+        os.environ.setdefault("MASTER_PORT", str(resolve_slurm_master_port() or 29500))
+    if not use_cpu:
+        torch.cuda.set_device(int(os.environ.get("LOCAL_RANK", "0")))
+    options = {"backend": "gloo" if use_cpu else "nccl"}
+    if timeout_minutes is not None:
+        options["timeout"] = datetime.timedelta(minutes=timeout_minutes)
+    torch.distributed.init_process_group(**options)
+
+
+def _configure_model_provider(provider, *, tp, pp, ep, etp, dtype, use_cpu=False):
+    provider.tensor_model_parallel_size = tp
+    provider.pipeline_model_parallel_size = pp
+    provider.expert_model_parallel_size = ep
+    provider.expert_tensor_parallel_size = etp
+    provider.pipeline_dtype = dtype
+    provider.params_dtype = dtype
+    provider.bf16 = dtype == torch.bfloat16
+    provider.fp16 = dtype == torch.float16
+    if use_cpu:
+        provider.use_cpu_initialization = True
+
+
+def _maybe_restore_pipeline_layout(bridge, provider, megatron_path, pp):
+    from megatron.bridge.training.model_load_save import load_model_config
+
+    checkpoint = Path(megatron_path)
+    iterations = [path for path in checkpoint.glob("iter_*") if path.name[5:].isdigit()]
+    if iterations:
+        checkpoint = max(iterations, key=lambda path: int(path.name[5:]))
+    config, _ = load_model_config(str(checkpoint))
+    layout = getattr(config, "pipeline_model_parallel_layout", None)
+    if layout is not None and config.pipeline_model_parallel_size == pp:
+        provider.pipeline_model_parallel_layout = layout
+
+
+def _uses_model_builder(bridge):
+    return getattr(bridge._model_bridge, "USE_MODEL_CONFIG_FOR_CONVERSION", False)
+
+
+def _configure_model_config(config, **kwargs):
+    _configure_model_provider(config.transformer, **kwargs)
+
+
+def _hf_tokenizer_kwargs(bridge, *, trust_remote_code):
+    options = {"trust_remote_code": trust_remote_code}
+    revision = getattr(bridge, "hf_model_revision", None)
+    if revision is not None:
+        options["revision"] = revision
+    return options
+
+
+def _prepare_distributed_output(path, *, overwrite, source_paths=()):
+    destination = Path(path).resolve()
+    if destination.parent == destination:
+        raise ValueError("Refusing filesystem root as output")
+    for source in source_paths:
+        source = Path(source).resolve()
+        if destination == source or destination in source.parents or source in destination.parents:
+            raise ValueError(f"Output overlaps source: {destination}")
+    status = [None]
+    if torch.distributed.get_rank() == 0:
+        try:
+            if destination.exists() and any(destination.iterdir()):
+                if not overwrite:
+                    raise FileExistsError(f"Refusing non-empty output: {destination}")
+                shutil.rmtree(destination)
+            destination.mkdir(parents=True, exist_ok=True)
+        except OSError as error:
+            status[0] = str(error)
+    torch.distributed.broadcast_object_list(status, src=0)
+    if status[0]:
+        raise FileExistsError(status[0])
+
+
+def import_checkpoint(
+    *,
+    hf_model,
+    hf_revision,
+    megatron_path,
+    tp,
+    pp,
+    ep,
+    etp,
+    torch_dtype,
+    trust_remote_code,
+    low_memory_save,
+    distributed_timeout_minutes,
+    overwrite,
+):
+    _ensure_distributed_initialized(distributed_timeout_minutes)
+    _prepare_distributed_output(megatron_path, overwrite=overwrite, source_paths=[hf_model])
+    options = {"revision": hf_revision} if hf_revision is not None else {}
+    bridge = AutoBridge.from_hf_pretrained(
+        hf_model,
+        trust_remote_code=trust_remote_code,
+        torch_dtype=getattr(torch, torch_dtype),
+        **options,
+    )
+    provider = bridge.to_megatron_provider(load_weights=True)
+    _configure_model_provider(provider, tp=tp, pp=pp, ep=ep, etp=etp, dtype=getattr(torch, torch_dtype))
+    provider.finalize()
+    provider.initialize_model_parallel(seed=0)
+    model = provider.provide_distributed_model(wrap_with_ddp=False)
+    bridge.save_megatron_model(
+        model,
+        megatron_path,
+        hf_tokenizer_path=hf_model,
+        hf_tokenizer_kwargs=_hf_tokenizer_kwargs(bridge, trust_remote_code=trust_remote_code),
+        low_memory_save=low_memory_save,
+    )
